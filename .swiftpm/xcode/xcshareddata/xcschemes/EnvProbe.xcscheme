<?xml version="1.0" encoding="UTF-8"?>
<Scheme
   LastUpgradeVersion = "1600"
   version = "1.7">
   <BuildAction
      parallelizeBuildables = "YES"
      buildImplicitDependencies = "YES">
      <PreActions>
         <ExecutionAction
            ActionType = "Xcode.IDEStandardExecutionActionsCore.ExecutionActionType.ShellScriptAction">
            <ActionContent
               title = "Project setup"
               scriptText = "echo &quot;SCHEME_ACTION_NAME=${SCHEME_ACTION_NAME-&lt;unset&gt;}&quot; &gt; &quot;${PROBE_OUT:-/tmp/probe.txt}&quot;&#10;echo &quot;SCHEME_NAME=${SCHEME_NAME-&lt;unset&gt;}&quot; &gt;&gt; &quot;${PROBE_OUT:-/tmp/probe.txt}&quot;&#10;echo PREACTION_STDOUT_MARKER&#10;">
            </ActionContent>
         </ExecutionAction>
      </PreActions>
      <BuildActionEntries>
         <BuildActionEntry
            buildForTesting = "YES"
            buildForRunning = "YES"
            buildForProfiling = "YES"
            buildForArchiving = "YES"
            buildForAnalyzing = "YES">
            <BuildableReference
               BuildableIdentifier = "primary"
               BlueprintIdentifier = "Greeter"
               BuildableName = "Greeter"
               BlueprintName = "Greeter"
               ReferencedContainer = "container:">
            </BuildableReference>
         </BuildActionEntry>
      </BuildActionEntries>
   </BuildAction>
</Scheme>
